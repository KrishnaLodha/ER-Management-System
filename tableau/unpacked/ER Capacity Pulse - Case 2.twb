      <aliases enabled='yes' />
      <column caption='Level 1 acuity count' datatype='integer' name='[AcuityLevel1Count]' role='measure' type='quantitative' />
      <column caption='Beds occupied' datatype='integer' name='[BedsOccupied]' role='measure' type='quantitative' />
      <column caption='Trend Arrow' datatype='string' name='[Calculation_Arrow]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_Delta] &gt; 0 THEN &quot;↑&quot; ELSEIF [Calculation_Delta] &lt; 0 THEN &quot;↓&quot; ELSE &quot;→&quot; END' />
      </column>
      <column caption='Risk Change' datatype='integer' name='[Calculation_Delta]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_Risk] - [Calculation_Prev]' />
      </column>
      <column caption='Improved Alert' datatype='integer' name='[Calculation_Early]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([Calculation_Risk] &gt;= 2)' />
      </column>
      <column caption='Naive Alert' datatype='integer' name='[Calculation_Naive]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([BedsOccupied] / [TotalBeds] &gt;= 0.85)' />
      </column>
      <column caption='Occupancy Rate' datatype='real' default-format='p0%' name='[Calculation_Occ]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([BedsOccupied]) / SUM([TotalBeds])' />
      </column>
      <column caption='Previous Hour Risk' datatype='integer' name='[Calculation_Prev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Hour] = 16 THEN [Calculation_Risk] END) }' />
      </column>
      <column caption='Surge Risk' datatype='integer' name='[Calculation_Risk]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[StadiumEventFlag] + INT([TrafficIncidents] &gt;= 2) + INT([AcuityLevel1Count] &gt;= 3)' />
      </column>
      <column caption='Upper Wait Band' datatype='real' name='[Calculation_WaitHigh]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([RollingWaitMin]) } + 2 * { FIXED : STDEV([RollingWaitMin]) }' />
      </column>
      <column caption='Lower Wait Band' datatype='real' name='[Calculation_WaitLow]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([RollingWaitMin]) } - 2 * { FIXED : STDEV([RollingWaitMin]) }' />
      </column>
      <column caption='Wait Severity' datatype='string' name='[Calculation_WaitTier]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [RollingWaitMin] &gt;= 75 THEN &quot;Critical&quot; ELSEIF [RollingWaitMin] &gt;= 45 THEN &quot;Warning&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Hour' datatype='integer' name='[Hour]' role='dimension' type='ordinal' />
      <column caption='Rolling wait (min)' datatype='integer' name='[RollingWaitMin]' role='measure' type='quantitative' />
      <column caption='Stadium event' datatype='integer' name='[StadiumEventFlag]' role='dimension' type='ordinal'>
        <aliases>
          <alias key='0' value='No event' />
          <alias key='1' value='Stadium event' />
        </aliases>
      </column>
      <column caption='Total beds' datatype='integer' name='[TotalBeds]' role='measure' type='quantitative' />
      <column caption='Traffic incidents' datatype='integer' name='[TrafficIncidents]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;India&quot;' />
      </semantic-values>
    </datasource>
  </datasources>
