      <aliases enabled='yes' />
      <column caption='Beds Occupied' datatype='integer' name='[BedsOccupied]' role='measure' type='quantitative' />
      <column caption='Occupancy Rate' datatype='real' default-format='p0.0%' name='[Calculation_0543222293045248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([BedsOccupied]) / SUM([TotalBeds])' />
      </column>
      <column caption='Critical Patients' datatype='integer' name='[Calculation_0543222293102593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Pivot Field Names] = &quot;Emergency (High)&quot;&#13;&#10;    OR [Pivot Field Names] = &quot;Less Urgent&quot;&#13;&#10;    THEN [Pivot Field Values]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Total Patients' datatype='integer' name='[Calculation_0543222293143554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pivot Field Values])' />
      </column>
      <column caption='Surge Risk Score' datatype='real' name='[Calculation_0543222293192707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    0.40 * (SUM([BedsOccupied]) / SUM([TotalBeds]))&#13;&#10;)&#13;&#10;+&#13;&#10;(&#13;&#10;    0.35 * (AVG([RollingWaitMin]) / 90)&#13;&#10;)&#13;&#10;+&#13;&#10;(&#13;&#10;    0.15 * AVG([StadiumEventFlag])&#13;&#10;)&#13;&#10;+&#13;&#10;(&#13;&#10;    0.10 * (AVG([TrafficIncidentCount]) / 10)&#13;&#10;)' />
      </column>
      <column caption='Risk Severity' datatype='string' name='[Calculation_0543222293254148]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0543222293192707] &gt;= 0.75 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [Calculation_0543222293192707] &gt;= 0.50 THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='Lower Wait Band' datatype='real' name='[Calculation_0543222297219077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([RollingWaitMin]) }&#13;&#10;-&#13;&#10;2 * { FIXED : STDEV([RollingWaitMin]) }' />
      </column>
      <column caption='Upper Wait Band' datatype='real' name='[Calculation_0543222297280518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([RollingWaitMin]) }&#13;&#10;+&#13;&#10;2 * { FIXED : STDEV([RollingWaitMin]) }' />
      </column>
      <column caption='Trend Arrow' datatype='string' name='[Calculation_0543222300880905]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP([Calculation_0543222293045248], -1)) THEN &quot;—&quot;&#13;&#10;ELSEIF [Calculation_0543222293045248] &gt; LOOKUP([Calculation_0543222293045248], -1) THEN &quot;▲&quot;&#13;&#10;ELSEIF [Calculation_0543222293045248] &lt; LOOKUP([Calculation_0543222293045248], -1) THEN &quot;▼&quot;&#13;&#10;ELSE &quot;→&quot;&#13;&#10;END'>
          <table-calc ordering-field='[federated.168pa66184sxn41gveiy61bzznyb].[Hour]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Is Latest Hour' datatype='boolean' name='[Calculation_0543222301253642]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-field='[federated.168pa66184sxn41gveiy61bzznyb].[Hour]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Acuity Load' datatype='real' name='[Calculation_0543222301499404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(IF [Pivot Field Names] = &quot;Emergency (High)&quot; THEN [Pivot Field Values] * 5 ELSE 0 END)&#13;&#10;    +&#13;&#10;    SUM(IF [Pivot Field Names] = &quot;Less Urgent&quot; THEN [Pivot Field Values] * 4 ELSE 0 END)&#13;&#10;    +&#13;&#10;    SUM(IF [Pivot Field Names] = &quot;Non-Urgent&quot; THEN [Pivot Field Values] * 3 ELSE 0 END)&#13;&#10;    +&#13;&#10;    SUM(IF [Pivot Field Names] = &quot;Resuscitation (Critical)&quot; THEN [Pivot Field Values] * 2 ELSE 0 END)&#13;&#10;    +&#13;&#10;    SUM(IF [Pivot Field Names] = &quot;Urgent&quot; THEN [Pivot Field Values] ELSE 0 END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([Pivot Field Values])' />
      </column>
      <column caption='Acuity Alert' datatype='string' name='[Calculation_0543222301626381]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0543222301499404] &gt;= 4 THEN &quot;High Acuity&quot;&#13;&#10;ELSEIF [Calculation_0543222301499404] &gt;= 3 THEN &quot;Moderate Acuity&quot;&#13;&#10;ELSE &quot;Low Acuity&quot;&#13;&#10;END' />
      </column>
      <column caption='Critical Patient Mix %' datatype='real' default-format='p0.0%' name='[Calculation_0543222301753358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Pivot Field Names] = &quot;Emergency (High)&quot;&#13;&#10;    OR [Pivot Field Names] = &quot;Less Urgent&quot;&#13;&#10;    THEN [Pivot Field Values]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([Pivot Field Values])' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Hour]' role='dimension' type='ordinal' />
      <column caption='Triage Level' datatype='string' name='[Pivot Field Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Level1Count&quot;' value='Resuscitation (Critical)' />
          <alias key='&quot;Level2Count&quot;' value='Emergency (High)' />
          <alias key='&quot;Level3Count&quot;' value='Urgent' />
          <alias key='&quot;Level4Count&quot;' value='Less Urgent' />
          <alias key='&quot;Level5Count&quot;' value='Non-Urgent' />
        </aliases>
      </column>
      <column caption='Patient Count' datatype='integer' name='[Pivot Field Values]' role='measure' type='quantitative' />
      <column caption='Rolling Wait Min' datatype='integer' default-format='p0.0%' name='[RollingWaitMin]' role='measure' type='quantitative' />
      <column caption='Seasonal Flu Index' datatype='real' name='[SeasonalFluIndex]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Stadium Event Flag' datatype='integer' name='[StadiumEventFlag]' role='dimension' type='ordinal'>
        <aliases>
