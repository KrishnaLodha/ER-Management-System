    <worksheet name='08 - Surge Risk Monitoring'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>EMERGENCY ROOM SURGE RISK – HOURLY MONITORING</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ER_Capacity_Pulse_Extended_Demo_Dataset' name='federated.168pa66184sxn41gveiy61bzznyb' />
          </datasources>
          <datasource-dependencies datasource='federated.168pa66184sxn41gveiy61bzznyb'>
            <column caption='Beds Occupied' datatype='integer' name='[BedsOccupied]' role='measure' type='quantitative' />
            <column caption='Occupancy Rate' datatype='real' default-format='p0.0%' name='[Calculation_0543222293045248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([BedsOccupied]) / SUM([TotalBeds])' />
            </column>
            <column caption='Surge Risk Score' datatype='real' name='[Calculation_0543222293192707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    0.40 * (SUM([BedsOccupied]) / SUM([TotalBeds]))&#13;&#10;)&#13;&#10;+&#13;&#10;(&#13;&#10;    0.35 * (AVG([RollingWaitMin]) / 90)&#13;&#10;)&#13;&#10;+&#13;&#10;(&#13;&#10;    0.15 * AVG([StadiumEventFlag])&#13;&#10;)&#13;&#10;+&#13;&#10;(&#13;&#10;    0.10 * (AVG([TrafficIncidentCount]) / 10)&#13;&#10;)' />
            </column>
            <column caption='Risk Severity' datatype='string' name='[Calculation_0543222293254148]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0543222293192707] &gt;= 0.75 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [Calculation_0543222293192707] &gt;= 0.50 THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Hour]' role='dimension' type='ordinal' />
            <column caption='Rolling Wait Min' datatype='integer' default-format='p0.0%' name='[RollingWaitMin]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Stadium Event Flag' datatype='integer' name='[StadiumEventFlag]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='No Stadium Event' />
                <alias key='1' value='Stadium Event Active' />
              </aliases>
            </column>
            <column caption='Total Beds' datatype='integer' name='[TotalBeds]' role='measure' type='quantitative' />
            <column caption='Traffic Incident Count' datatype='integer' name='[TrafficIncidentCount]' role='measure' type='quantitative' />
            <column-instance column='[Hour]' derivation='Attribute' name='[attr:Hour:qk]' pivot='key' type='quantitative' />
            <column-instance column='[StadiumEventFlag]' derivation='Attribute' name='[attr:StadiumEventFlag:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Hour]' derivation='None' name='[none:Hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[RollingWaitMin]' derivation='Sum' name='[sum:RollingWaitMin:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0543222293045248]' derivation='User' name='[usr:Calculation_0543222293045248:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0543222293192707]' derivation='User' name='[usr:Calculation_0543222293192707:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0543222293254148]' derivation='User' name='[usr:Calculation_0543222293254148:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.168pa66184sxn41gveiy61bzznyb].[none:Hour:ok]' filter-group='3'>
            <groupfilter function='level-members' level='[none:Hour:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.168pa66184sxn41gveiy61bzznyb].[none:Hour:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='background-color' scope='cols' value='#00000000' />
            <format attr='background-color' data-class='subtotal' scope='cols' value='#00000000' />
